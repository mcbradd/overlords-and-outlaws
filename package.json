{
  "name": "overlords-and-outlaws",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:simulate": "tsx scripts/simulate.ts",
    "test:ui": "vitest run",
    "test:audit": "tsx scripts/decision-audit.ts 200 strict",
    "test:browser": "tsx scripts/ux-interactions.ts",
    "test:layout": "tsx scripts/ux-layout.ts",
    "test:cards": "node scripts/ux-cardfaces.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
